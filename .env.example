# Copy to .env (never commit .env) and export before starting the API.
API_KEY=change-me-to-a-long-random-string     # n8n must send this in the X-API-Key header
GEMINI_API_KEY=                               # optional; MRZ + regex work without it
GEMINI_MODEL=gemini-2.5-flash                 # check Google's docs for currently supported models
HOST=127.0.0.1
PORT=5000
MAX_UPLOAD_MB=10
MAX_PDF_PAGES=5
